@PACKAGE_INIT@

add_library(godot-cpp::godot-cpp UNKNOWN IMPORTED)

set_target_properties(godot-cpp::godot-cpp PROPERTIES
	IMPORTED_LOCATION             "@godot-cpp_LIB@"
	INTERFACE_INCLUDE_DIRECTORIES "@CMAKE_INSTALL_PREFIX@/include/godot-cpp;@CMAKE_INSTALL_PREFIX@/include/godot-cpp/core;@CMAKE_INSTALL_PREFIX@/include/godot-cpp/gen;@CMAKE_INSTALL_PREFIX@/include/godot-cpp/godot-headers"
)